 // src/evaluation/eval_worker.ts
+import { pathToFileURL } from "url";
+import { register } from "node:module";
+
+// Register a custom ESM resolve hook that converts bare Windows absolute
+// paths (C:\... or C:/...) to file:// URLs before Node's ESM loader sees
+// them. This fixes ERR_UNSUPPORTED_ESM_URL_SCHEME for dynamic imports
+// where the path is computed at runtime (e.g. import(path.join(cwd, ...))).
+if (process.platform === "win32") {
+  register("data:text/javascript," + encodeURIComponent(`
+    export function resolve(specifier, context, next) {
+      if (/^[A-Za-z]:[\\\\\/]/.test(specifier)) {
+        const fileUrl = "file:///" + specifier.replace(/\\\\/g, "/");
+        return next(fileUrl, context);
+      }
+      return next(specifier, context);
+    }
+  `));
+}
+
+// Belt-and-suspenders: also fix string-literal Windows paths in code text
+function fixWindowsImportPaths(code) {
+  return code.replace(
+    /\bimport\s*\(\s*(['"])([A-Za-z]:[\\\/][^'"]+)\1/g,
+    (_, quote, winPath) => `import(${quote}${pathToFileURL(winPath).href}${quote}`
+  );
+}

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Endstate",
  "version": "1.2.1",
  "identifier": "com.substratesystems.endstate",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Endstate",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "../../endstate/go-engine/endstate"
    ],
    "resources": {
      "../../endstate/modules/": "engine/modules/",
      "../../endstate/payload/": "engine/payload/",
      "../../endstate/VERSION": "engine/VERSION",
      "../../endstate/SCHEMA_VERSION": "engine/SCHEMA_VERSION"
    },
    "windows": {
      "nsis": {
        "installerIcon": "icons/installer.ico",
        "template": "./windows/installer.nsi"
      }
    }
  }
}

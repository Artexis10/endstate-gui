{
  "$schema": "https://schema.tauri.app/config/2/capability",
  "identifier": "default",
  "description": "Default capability for Endstate GUI",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:allow-open",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "../../endstate/go-engine/endstate",
          "sidecar": true
        }
      ]
    },
    "dialog:default",
    "updater:default",
    "process:default",
    "process:allow-restart"
  ]
}
